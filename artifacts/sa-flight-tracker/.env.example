# Vite/browser auth values. These are public Supabase project values only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Shared API server. Keep SUPABASE_SERVICE_ROLE_KEY server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=

# Random secret of at least 32 characters. Used to HMAC client IPs before the
# persistent POPIA request rate-limit key is stored in Supabase.
POPIA_RATE_LIMIT_HMAC_KEY=

# Transactional mail is sent through the Resend REST API (no connector required).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=SA Travel Agency
POPIA_DPO_EMAIL=
APP_BASE_URL=

# Optional: authenticated OpenSky requests have a higher daily quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Configure app.popia_aes_key in the new Supabase database, not here.
