# Optional for the Replit API's persisted Supabase data source.
# Leave both Supabase values unset to use the live OpenSky feed and OpenFlights
# airport dump directly.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Optional: authenticated OpenSky requests have a higher daily quota.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Only required by scripts/seed-openflights.mjs.
# Keep this key server-side; never put it in frontend variables.
SUPABASE_SERVICE_ROLE_KEY=
